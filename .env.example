# Copy this file to .env and fill in your own keys. NEVER commit .env.
# No real keys are stored in this repo.

# Gemini API key (free tier) — REQUIRED for real AI replies.
# Without it the bot replies honestly in the customer's language that
# AI is not connected yet (it never pretends to be the AI).
# Create it at Google AI Studio, signed in as musasocialstore000@gmail.com:
# https://aistudio.google.com/ -> Get API key -> Create API key
# in a new project, name the key "Musa WhatsApp Bot", then paste it here.
# (Sign in as Musa Store first — the 2026-11-19 attempt signed in as
# kinghacker0997ppp hit an age-verification redirect.)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Resend API key (free tier) — for forwarding leads by email
# https://resend.com/api-keys
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
RESEND_FROM_EMAIL=onboarding@resend.dev

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Data directory (JSON store + Baileys auth sessions + uploads)
DATA_DIR=./data
